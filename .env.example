# Backend settings. Copy to backend/.env (never commit .env).
# With everything left at its default, the app runs in demo mode: no accounts needed.

NODE_ENV=development
PORT=8080
# Serve the frontend from the API process (local runs only).
SERVE_FRONTEND=true
# Frontend origins allowed to call the API, comma-separated. On Vercel this defaults to the project URL.
CORS_ORIGINS=http://localhost:8080
# Used for links inside push alerts.
FRONTEND_URL=http://localhost:8080

# fake | firebase
AUTH_MODE=fake
# memory | firestore
STORAGE_MODE=memory
# fake | onesignal
NOTIFY_MODE=fake

# Firebase service account (Project settings > Service accounts > Generate new private key).
# Paste the private key on one line with \n for line breaks, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Only the cloud name: the API accepts image URLs from this Cloudinary account only.
CLOUDINARY_CLOUD_NAME=

# OneSignal > Settings > Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
